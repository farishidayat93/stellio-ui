STELLIO_HOST=localhost
STELLIO_PORT=8765

# Used by `docker compose` (see compose.yaml). Both are optional.
# UI_PORT=3000                   # host port the container is published on
# The container always writes its SQLite file to /data/stellio-ui.db inside the
# mounted volume, so STELLIO_DB_PATH is only relevant when running the built
# server directly:
# STELLIO_DB_PATH=stellio-ui.db  # default: ./stellio-ui.db
# PORT=3000                      # adapter-node listen port / HOST=0.0.0.0
# ORIGIN=http://localhost:3000   # set when served behind another hostname

# Optional tuning knobs, read straight from the environment. They are not listed
# in src/env.ts because SvelteKit validates every name declared there against
# .env and would make it required. Defaults shown below.
# STELLIO_TIMEOUT_MS=60000       # per-request timeout for Stellio calls
# STELLIO_MAX_CONCURRENCY=4      # max Stellio requests in flight at once
# STELLIO_CACHE_DISABLED=false   # bypass the in-process response cache